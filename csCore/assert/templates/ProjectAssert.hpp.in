#pragma once
#include <libassert/assert.hpp>


#define @CS_ASSERT_PROJECT_NAME@_ASSERT_LEVEL @CS_ASSERT_LEVEL@

// just a overload of libassert defines
#define @CS_ASSERT_PROJECT_NAME@_DEBUG_ASSERT(...) DEBUG_ASSERT(__VA_ARGS__)
#define @CS_ASSERT_PROJECT_NAME@_ASSERT(...) ASSERT(__VA_ARGS__)
#define @CS_ASSERT_PROJECT_NAME@_ASSUME(...) ASSUME(__VA_ARGS__)
#define @CS_ASSERT_PROJECT_NAME@_PANIC(...) PANIC(__VA_ARGS__)
#define @CS_ASSERT_PROJECT_NAME@_UNREACHABLE(...) UNREACHABLE(__VA_ARGS__)
#define @CS_ASSERT_PROJECT_NAME@_DEBUG_ASSERT_VAL(...) DEBUG_ASSERT_VAL(__VA_ARGS__)
#define @CS_ASSERT_PROJECT_NAME@_ASSUME_VAL(...) ASSUME_VAL(__VA_ARGS__)
#define @CS_ASSERT_PROJECT_NAME@_ASSERT_VAL(...) ASSERT_VAL(__VA_ARGS__)
